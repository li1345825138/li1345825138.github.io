#!/usr/bin/env pwsh
<#
.SYNOPSIS
    WinSAT Tool — benchmark disk and memory performance.

.DESCRIPTION
    Option 1 measures sequential and random read / write bandwidth for one or all fixed
    drives using the built-in `winsat disk` assessment. Option 2 reports memory
    bandwidth using the built-in `winsat mem` assessment. When WinSAT is unavailable
    (e.g. running under WSL) the memory test exits with a diagnostic message.

.NOTES
    Requires Administrator privileges (needed by winsat).
#>

# Function to check if running as administrator
function Test-Administrator {
    $currentUser = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = New-Object Security.Principal.WindowsPrincipal($currentUser)
    return $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

# Function to get all available fixed/ready drive letters
function Get-AllDriveLetters {
    $drives = @()
    foreach ($drive in Get-PSDrive -PSProvider FileSystem) {
        if ($drive.Name -match '^[A-Z]$' -and (Test-Path "$($drive.Name):\\")) {
            $drives += $drive.Name
        }
    }
    return $drives
}

# Function to get and validate drive letter from user
function Get-DriveLetter {
    while ($true) {
        $user_input = Read-Host "Enter drive letter to test (e.g., C or C:), or press Enter to test all drives"
        $driveLetter = $user_input.Trim().ToUpper().TrimEnd(':')

        if ([string]::IsNullOrEmpty($driveLetter)) {
            $allDrives = Get-AllDriveLetters
            if ($allDrives.Count -eq 0) {
                Write-Host "No usable drives found." -ForegroundColor Red
                return $null
            }
            return ,$allDrives
        }

        if ($driveLetter -match '^[A-Z]$') {
            if (Test-Path "$driveLetter`:\\") {
                return $driveLetter
            } else {
                Write-Host "Drive $driveLetter`: does not exist. Please try again." -ForegroundColor Yellow
            }
        } else {
            Write-Host "Please enter a valid drive letter (e.g., C or C:)" -ForegroundColor Yellow
        }
    }
}

# Function to run all tests on a single drive and display results
function Invoke-TestDrive {
    param(
        [string]$DriveLetter
    )

    Write-Host ""
    Write-Host "============================================================="
    Write-Host "Testing drive ${DriveLetter}:" -ForegroundColor Yellow
    Write-Host "============================================================="

    $seqReadResult   = Parse-WinsatOutput (Invoke-RunSequentialRead  -DriveLetter $DriveLetter)
    $seqWriteResult  = Parse-WinsatOutput (Invoke-RunSequentialWrite -DriveLetter $DriveLetter)
    $randReadResult  = Parse-WinsatOutput (Invoke-RunRandomRead     -DriveLetter $DriveLetter)
    $randWriteResult = Parse-WinsatOutput (Invoke-RunRandomWrite    -DriveLetter $DriveLetter)

    Write-Host "Sequential Read:  $seqReadResult MB/s"  -ForegroundColor White
    Write-Host "Sequential Write: $seqWriteResult MB/s" -ForegroundColor White
    Write-Host "Random Read:      $randReadResult MB/s" -ForegroundColor White
    Write-Host "Random Write:     $randWriteResult MB/s" -ForegroundColor White
}

# Function to run sequential read test
function Invoke-RunSequentialRead {
    param(
        [string]$DriveLetter
    )

    Write-Host "Running sequential read test..." -ForegroundColor Cyan
    $output = winsat disk -seq -read -drive $DriveLetter 2>&1
    if ($LASTEXITCODE -ne 0) {
        Write-Host "Error running sequential read test: $output" -ForegroundColor Red
        return $null
    }
    return $output
}

# Function to run sequential write test
function Invoke-RunSequentialWrite {
    param(
        [string]$DriveLetter
    )

    Write-Host "Running sequential write test..." -ForegroundColor Cyan
    $output = winsat disk -seq -write -drive $DriveLetter 2>&1
    if ($LASTEXITCODE -ne 0) {
        Write-Host "Error running sequential write test: $output" -ForegroundColor Red
        return $null
    }
    return $output
}

# Function to run random read test
function Invoke-RunRandomRead {
    param(
        [string]$DriveLetter
    )

    Write-Host "Running random read test..." -ForegroundColor Cyan
    $output = winsat disk -ran -read -drive $DriveLetter 2>&1
    if ($LASTEXITCODE -ne 0) {
        Write-Host "Error running random read test: $output" -ForegroundColor Red
        return $null
    }
    return $output
}

# Function to run random write test
function Invoke-RunRandomWrite {
    param(
        [string]$DriveLetter
    )

    Write-Host "Running random write test..." -ForegroundColor Cyan
    $output = winsat disk -ran -write -drive $DriveLetter 2>&1
    if ($LASTEXITCODE -ne 0) {
        Write-Host "Error running random write test: $output" -ForegroundColor Red
        return $null
    }
    return $output
}

# Function to parse Winsat output and extract MB/s values
function Parse-WinsatOutput {
    param(
        [string]$RawOutput
    )

    if ([string]::IsNullOrEmpty($RawOutput)) {
        return "N/A"
    }

    # Look for patterns like "XX.X MB/s" in the output.
    $m = [regex]::Match($RawOutput, '(\d+\.?\d*)\s+MB/s')
    if ($m.Success) {
        return [float]$m.Groups[1].Value
    }

    return "Error"
}

# Function to display the test category menu
function Show-MainMenu {
    Write-Host ""
    Write-Host "Select test category" -ForegroundColor Cyan
    Write-Host "1. Disk"
    Write-Host "2. Memory"
    $choice = Read-Host "Enter option"
    return $choice
}

# ─── Memory helpers ───────────────────────────────────────────────────────────

# Run bare `winsat mem` and capture its output into $script:_winsatOutput.
# Returns $true on success, $false otherwise.
function Invoke-WinSATMem {
    # Reset the script-scoped output buffer so a previous run's state never leaks in
    $script:_winsatOutput = @()

    # Bail out fast if winsat isn't on this machine (e.g. running under WSL)
    $winsatExe = Get-Command winsat -ErrorAction SilentlyContinue
    if (-not $winsatExe) { return $false }

    try {
        & winsat mem 2>&1 | ForEach-Object {
            # $_ may be a String or ErrorRecord — coerce to plain string and trim trailing whitespace
            $line = ("$_").TrimEnd()
            # Strip the BOM (U+FEFF) if it appears as the first character of output
            if ($line.Length -gt 0 -and [char]::ConvertToUtf32($line, 0) -eq 0xFEFF) {
                $line = $line.Substring(1)
            }
            # Discard localized progress prefixes (e.g. "> ") and empty lines
            $line = $line -replace '^>\s{0,8}', ''
            if ($line) { $script:_winsatOutput += $line }
        }
    } catch {
        return $false
    }

    # Look for the featured "Memory performance  XXX.XX MB/s" line. WinSAT writes
    # localized headers, so we match by pattern on the value, not the text label.
    foreach ($line in $script:_winsatOutput) {
        if ($line -match '[\d,]+\.?\d*\s*MB/s') {
            return $true
        }
    }
    return $false
}

# Parse one label/value pair from the winsat output for *memory*.
# The memory line format is always: a localized label followed by a run of
# 2+ spaces and then the value.  Example output on a Chinese locale:
#     内存性能                                         34,073.51 MB/s
# English locale:
#     Memory performance                               34,073.51 MB/s
#
# We match BOTH the localized label and English label to keep this script
# working on either system language.
function Get-WinsatField {
    param(
        [string]$Pattern = 'memory|内存性能'          # regex matched against label
    )

    if ($null -eq $script:_winsatOutput) { return $null }

    foreach ($line in $script:_winsatOutput) {
        # Split each line into a label + value cell on a run of 2+ spaces.
        # This works regardless of whether the label is ASCII or CJK because
        # the padding between label and value is *always* whitespace.
        $parts = $line -split '\s{2,}', 2
        if ($parts.Count -lt 2) { continue }
        $label = $parts[0].Trim()
        $valueCell = $parts[1].Trim()

        # Run the value regex ONCE and immediately capture its groups into locals.
        # If we rely on $Matches being intact at the point where we build the return
        # hashtable, a subsequent -match (e.g. the $label pattern check) will clobber
        # $Matches — and $Matches[1]/[2] silently become $null.
        $vm = [regex]::Match($valueCell, '([\d,]+\.?\d*)\s*(\S*)\s*$')
        if (-not $vm.Success) { continue }
        $val = $vm.Groups[1].Value
        $unit = $vm.Groups[2].Value

        if ($label -match $Pattern) {
            return @{
                Name  = $label
                Value = $val
                Unit  = $unit
            }
        }
    }
    return $null
}

function Invoke-TestMemory {
    Write-Host ""
    Write-Host "=============================================================" -ForegroundColor Cyan
    Write-Host "Memory Benchmark" -ForegroundColor Cyan
    Write-Host "=============================================================" -ForegroundColor Cyan

    # Show total installed RAM (informational only; failure does not affect the benchmark)
    $os = $null
    try {
        $os = Get-CimInstance Win32_OperatingSystem -ErrorAction Stop
    } catch {
        Write-Host "Warning: Get-CimInstance failed ($_) — RAM size will be unknown." -ForegroundColor Yellow
    }
    if ($os -ne $null) {
        $totalGB = [math]::Round($os.TotalVisibleMemorySize / 1MB, 2)
        Write-Host "Total installed RAM: ${totalGB} GB" -ForegroundColor Gray
    } else {
        Write-Host "Total installed RAM: (unknown)" -ForegroundColor Gray
    }

    # Single test path: use only the official `winsat mem` tool
    $winsatOk = $false
    try {
        $winsatOk = Invoke-WinSATMem
    } catch {
        Write-Host "Error: Invoke-WinSATMem threw ($_)." -ForegroundColor Red
        $winsatOk = $false
    }

    if (-not $winsatOk) {
        Write-Host "winsat mem failed or is unavailable. Possible causes:"
        Write-Host "  1. WinSAT component is missing (e.g. WSL, Server Core)"
        Write-Host "  2. Not running as Administrator"
        Write-Host "  3. Group Policy disabled WinSAT"
        return
    }

    # Parse the "Memory performance  XXX.XX MB/s" line from the winsat output
    $memResult = Get-WinsatField -Pattern 'memory|内存性能'   # '内存性能' is the Chinese locale equivalent

    if ($memResult) {
        Write-Host ""
        Write-Host "Memory Performance: $($memResult.Value) $($memResult.Unit)" -ForegroundColor White
    } else {
        Write-Host "Warning: winsat mem completed but no 'Memory performance' line was found."
        Write-Host "Raw output for debugging:"
        $script:_winsatOutput | ForEach-Object { Write-Host "  $_" -ForegroundColor Gray }
    }

    Write-Host ""
    Write-Host "Memory test completed!" -ForegroundColor Green
}

# Main execution
if (-not (Test-Administrator)) {
    Write-Host "This script requires administrator privileges to run winsat." -ForegroundColor Red
    Write-Host "Please run PowerShell as Administrator and try again." -ForegroundColor Red
    exit 1
}

try {
    $choice = Show-MainMenu

    switch ($choice) {
        "1" {
            # --- Disk test (existing logic) ---
            $driveInput = Get-DriveLetter

            if ($null -eq $driveInput) {
                exit 1
            }

            if ($driveInput -is [array]) {
                Write-Host "Testing all available drives: $($driveInput -join ', ')" -ForegroundColor Cyan
                foreach ($dl in $driveInput) {
                    Invoke-TestDrive -DriveLetter $dl
                }
            } else {
                Invoke-TestDrive -DriveLetter $driveInput
            }
            Write-Host "Test completed!" -ForegroundColor Green
        }
        "2" {
            # --- Memory test (new) ---
            Invoke-TestMemory
        }
        default {
            Write-Warning "Unknown option selected."
        }
    }
} catch {
    Write-Host "An error occurred: $_" -ForegroundColor Red
    Write-Host "Stack trace:" -ForegroundColor Red
    Write-Host $_.ScriptStackTrace -ForegroundColor DarkGray
    exit 1
}