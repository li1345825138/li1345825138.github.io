#!/usr/bin/env pwsh
# Office License Key Management Script

# Function to check if running as administrator
function Test-Administrator {
    $currentUser = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = New-Object Security.Principal.WindowsPrincipal($currentUser)
    return $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

<#
.SYNOPSIS
    Locates the OSPP.VBS script used for Office license management.

.DESCRIPTION
    This function searches for the OSPP.VBS script file in common Microsoft Office
    installation directories. It first checks predefined standard paths, and if not
    found, performs a recursive search within the main Office installation directories.

    The function searches in order of priority:
    - Common Office 16 (2016+) installation paths for both 64-bit and 32-bit
    - Common Office 15 (2013) installation paths for both 64-bit and 32-bit
    - Recursive search in Program Files\Microsoft Office directories

.PARAMETER None
    This function does not accept any parameters.

.RETURNS
    Returns the full path to the OSPP.VBS file if found, or $null if not found.

.EXAMPLE
    $osppPath = Find-OSPPFile
    Searches for OSPP.VBS and stores the path in $osppPath variable.

.NOTES
    - Searches both 64-bit and 32-bit Office installation paths
    - Includes support for Office 2013 (Office15) and newer versions (Office16+)
    - Uses silent error handling during recursive search to avoid interruptions
    - Returns $null when the file cannot be located in any searched location
#>
function Find-OSPPFile {
    # Common Office installation paths
    $commonPaths = @(
        "C:\Program Files\Microsoft Office\root\Office16\OSPP.VBS",
        "C:\Program Files (x86)\Microsoft Office\root\Office16\OSPP.VBS",
        "C:\Program Files\Microsoft Office\Office16\OSPP.VBS",
        "C:\Program Files (x86)\Microsoft Office\Office16\OSPP.VBS",
        "C:\Program Files\Microsoft Office\root\Office15\OSPP.VBS",
        "C:\Program Files (x86)\Microsoft Office\root\Office15\OSPP.VBS",
        "C:\Program Files\Microsoft Office\Office15\OSPP.VBS",
        "C:\Program Files (x86)\Microsoft Office\Office15\OSPP.VBS"
    )
    
    # Check common paths first
    foreach ($path in $commonPaths) {
        if (Test-Path $path) {
            return $path
        }
    }
    
    # If not found in common paths, search more broadly
    $searchPaths = @(
        "C:\Program Files\Microsoft Office",
        "C:\Program Files (x86)\Microsoft Office"
    )
    
    foreach ($searchPath in $searchPaths) {
        if (Test-Path $searchPath) {
            $foundFile = Get-ChildItem -Path $searchPath -Recurse -Name "OSPP.VBS" -ErrorAction SilentlyContinue | Select-Object -First 1
              if ($foundFile) {
                  return Join-Path $searchPath $foundFile
              }
        }
    }

    # Return nothing if not found
    return $null
}

<#
.SYNOPSIS
    Retrieves the last 5 characters of installed Office product keys.

.DESCRIPTION
    This function executes the OSPP.vbs script with the /dstatus parameter to retrieve
    license status information, then parses the output to extract the last 5 characters
    of all installed Office product keys. This is useful for identifying and managing
    installed licenses without exposing the full product key.

.PARAMETER OSPPPath
    Specifies the full path to the OSPP.vbs script used for Office license management.
    Typically located at "%ProgramFiles%\Microsoft Office\Office16\OSPP.VBS" or similar.

.RETURNS
    Returns an array of strings containing the last 5 characters of each installed
    Office product key (e.g., @("ABCDE", "FGHIJ", "KLMNO")).

.EXAMPLE
    $keys = Get-OfficeProductKeys -OSPPPath "$env:ProgramFiles\Microsoft Office\Office16\OSPP.VBS"
    Retrieves all installed Office product key endings.

.NOTES
    - The function relies on the specific output format of OSPP.vbs /dstatus command
    - Only extracts the last 5 characters as shown in the "Last 5 characters" lines
    - Returns an empty array if no product keys are found
    - Requires the OSPP.vbs script to be accessible at the specified path
#>
function Get-OfficeProductKeys {
    param (
        [Parameter(Mandatory=$true)]
        [string]$OSPPPath
    )

    $statusOutput = & cscript $OSPPPath /dstatus 2>&1

    # Parse output to find all product keys
    $keysArray = @()
    foreach ($line in $statusOutput) {
        # Look for lines containing product keys
        if ($line -match "Last 5 characters of installed product key: ([A-Z0-9]{5})") {
            $keyEnding = $matches[1]
            $keysArray += $keyEnding
        }
    }

    return $keysArray
}

<#
.SYNOPSIS
    Configures and installs a specific Microsoft Office edition.

.DESCRIPTION
    This function sets up the specified Microsoft Office edition by configuring
    the appropriate installation parameters and invoking the Office Click-to-Run
    installer. It supports multiple Office editions including Office 2019, 2021,
    2024, and Office 365 ProPlus.

    The function:
    - Maps user selection to predefined Office configuration templates
    - Constructs the required command-line arguments for Office installation
    - Launches the Office Click-to-Run installer with the configured parameters
    - Handles invalid selections gracefully

.PARAMETER officeEdition
    Specifies the Office edition to install. Valid values are:
    "1" - Office 2019 ProPlus
    "2" - Office 2021 ProPlus
    "3" - Office 2024 ProPlus
    "4" - Office 365 ProPlus

.RETURNS
    None. The function performs the installation operation and displays status messages.

.EXAMPLE
    Set-OfficeEdition -officeEdition "1"
    Installs Office 2019 ProPlus edition.

.EXAMPLE
    Set-OfficeEdition "2"
    Installs Office 2021 ProPlus edition.

.NOTES
    - Requires administrator privileges to execute successfully
    - Uses the Office Click-to-Run installer located at the standard path
    - Configures common installation parameters including platform, culture, and excluded apps
    - The function waits for the installation process to complete before returning
#>
function Set-OfficeEdition {
    param (
        [Parameter(Mandatory=$true)]
        [string]$officeEdition
    )
    $commonArgsTemplate = @{
        Platform = "x64"
        Culture = "en-us"
        MediaType = "CDN"
        SourceType = "CDN"
        FilterTeamsAddon = "disabled"
        FilterBingInstall = "disabled"
        FilterBingUpdate = "disabled"
        RemoveProducts = "AllProducts"
    }

    $officeConfigurations = @{
        "1" = @{
            DisplayName = "Office 2019 ProPlus"
            CDNBaseUrl = "http://officecdn.microsoft.com/pr/492350f6-3a01-4f97-b9c0-c7c6ddf67d60"
            BaseUrl = "http://officecdn.microsoft.com/pr/492350f6-3a01-4f97-b9c0-c7c6ddf67d60"
            DeliveryMechanism = "492350f6-3a01-4f97-b9c0-c7c6ddf67d60"
            ProductToAdd = "ProPlus2019Retail.16_en-us_x-none"
            ExcludedApps = "groove,lync,onedrive,teams"
            Version = "16.0.19530.20184"
        }
        "2" = @{
            DisplayName = "Office 2021 ProPlus"
            CDNBaseUrl = "http://officecdn.microsoft.com/pr/492350f6-3a01-4f97-b9c0-c7c6ddf67d60"
            BaseUrl = "http://officecdn.microsoft.com/pr/492350f6-3a01-4f97-b9c0-c7c6ddf67d60"
            DeliveryMechanism = "492350f6-3a01-4f97-b9c0-c7c6ddf67d60"
            ProductToAdd = "ProPlus2021Retail.16_en-us_x-none"
            ExcludedApps = "groove,onedrive,teams"
            Version = "16.0.19530.20184"
        }
        "3" = @{
            DisplayName = "Office 2024 ProPlus"
            CDNBaseUrl = "http://officecdn.microsoft.com/pr/492350f6-3a01-4f97-b9c0-c7c6ddf67d60"
            BaseUrl = "http://officecdn.microsoft.com/pr/492350f6-3a01-4f97-b9c0-c7c6ddf67d60"
            DeliveryMechanism = "492350f6-3a01-4f97-b9c0-c7c6ddf67d60"
            ProductToAdd = "ProPlus2024Retail.16_en-us_x-none"
            ExcludedApps = "groove,onedrive,teams"
            Version = "16.0.19628.20150"
        }
        "4" = @{
            DisplayName = "Office 365 ProPlus"
            CDNBaseUrl = "http://officecdn.microsoft.com/pr/492350f6-3a01-4f97-b9c0-c7c6ddf67d60"
            BaseUrl = "http://officecdn.microsoft.com/pr/492350f6-3a01-4f97-b9c0-c7c6ddf67d60"
            DeliveryMechanism = "492350f6-3a01-4f97-b9c0-c7c6ddf67d60"
            ProductToAdd = "O365ProPlusRetail.16_en-us_x-none"
            ExcludedApps = "groove,lync,onedrive,teams"
            Version = "16.0.19628.20150"
        }
    }

    switch ($officeEdition) {
        "1" { $config = $officeConfigurations."1" }
        "2" { $config = $officeConfigurations."2" }
        "3" { $config = $officeConfigurations."3" }
        "4" { $config = $officeConfigurations."4" }
        default {
            Write-Host "Unknown option selected"
            return
        }
    }

    if ($config) {
        Write-Host "Updating Office to $($config.DisplayName) Edition..."
        Write-Host "Please wait..."

        $office_args = @(
            "platform=$($commonArgsTemplate.Platform)",
            "culture=$($commonArgsTemplate.Culture)",
            "productstoadd=$($config.ProductToAdd)",
            "cdnbaseurl.16=$($config.CDNBaseUrl)",
            "baseurl.16=$($config.BaseUrl)",
            "version.16=$($config.Version)",
            "mediatype.16=$($commonArgsTemplate.MediaType)",
            "sourcetype.16=$($commonArgsTemplate.SourceType)",
            "deliverymechanism=$($config.DeliveryMechanism)",
            "$($config.ProductToAdd.Split('.')[0]).excludedapps.16=$($config.ExcludedApps)",
            "flt.useteamsaddon=$($commonArgsTemplate.FilterTeamsAddon)",
            "flt.usebingaddononinstall=$($commonArgsTemplate.FilterBingInstall)",
            "flt.usebingaddononupdate=$($commonArgsTemplate.FilterBingUpdate)",
            "productstoremove=$($commonArgsTemplate.RemoveProducts)"
        )

        Start-Process -FilePath "C:\Program Files\Common Files\Microsoft Shared\ClickToRun\OfficeClickToRun.exe" -ArgumentList $office_args -Wait
    }
}

<#
.SYNOPSIS
    Retrieves information about installed Microsoft Office editions.

.DESCRIPTION
    This function detects and returns the currently installed Microsoft Office editions
    by querying Windows registry keys for both Click-to-Run (C2R) and traditional
    Office installations. It searches multiple registry paths to ensure compatibility
    with different Office versions and installation types (32-bit/64-bit).

    The function checks:
    - Click-to-Run registry locations for modern Office installations
    - Traditional Office registry locations for older installations
    - Both HKLM and WOW6432Node registry hives for architecture compatibility

.PARAMETER None
    This function does not accept any parameters.

.RETURNS
    Returns a string containing the detected Office edition(s) or status information:
    - Edition names (e.g., "ProPlus2019Retail", "O365ProPlusRetail")
    - "Traditional Office Installation" for legacy installations
    - "No Office installation found" if no Office is detected

.EXAMPLE
    $edition = Get-InstalledOfficeEditions
    Write-Host "Detected Office: $edition"

.NOTES
    - The function handles registry access errors gracefully
    - Searches multiple registry paths to maximize detection accuracy
    - Returns space-separated edition names when multiple editions are found
#>
function Get-InstalledOfficeEditions {
    # Define registry paths for checking Office installations
    $regPaths = @(
        "HKLM:\SOFTWARE\Microsoft\Office\ClickToRun",
        "HKLM:\SOFTWARE\WOW6432Node\Microsoft\Office\ClickToRun"
    )

    foreach ($regPath in $regPaths) {
        if (Test-Path $regPath) {
            try {
                # Get the ActiveConfiguration to identify installed products
                $productIdPath = Join-Path $regPath "ProductReleaseIDs"
                if (Test-Path $productIdPath) {
                    $activeConfig = Get-ItemProperty -Path $productIdPath -Name "ActiveConfiguration" -ErrorAction SilentlyContinue

                    if ($activeConfig) {
                        $configName = $activeConfig.ActiveConfiguration
                        $productPath = Join-Path $productIdPath $configName

                        if (Test-Path $productPath) {
                            # Get all subkeys under the active configuration
                            $allSubKeys = Get-ChildItem -Path $productPath

                            $installedEditions = @()
                            foreach ($subKey in $allSubKeys) {
                                $subKeyName = $subKey.PSChildName
                                # Filter for Office product IDs that end with .16 (indicating Office 2016+)
                                if ($subKeyName -match '\.16$' -and
                                    ($subKeyName -match 'Retail|Volume|Promotional|Subscription')) {
                                    $productName = $subKeyName.TrimEnd(".16")
                                    $installedEditions += $productName
                                }
                            }

                            if ($installedEditions.Count -gt 0) {
                                $result = $installedEditions -join ' '
                                return $result
                            }
                        }
                    }
                }
            }
            catch {
                # Continue to next registry path if there's an error
                continue
            }
        }
    }

    # Check the Wow6432Node as well if primary path doesn't work
    $regPaths32 = @(
        "HKLM:\SOFTWARE\WOW6432Node\Microsoft\Office\ClickToRun",
        "HKLM:\SOFTWARE\Microsoft\Office\ClickToRun"
    )

    foreach ($regPath in $regPaths32) {
        if (Test-Path $regPath) {
            try {
                # Get the ActiveConfiguration to identify installed products
                $productIdPath = Join-Path $regPath "ProductReleaseIDs"
                if (Test-Path $productIdPath) {
                    $activeConfig = Get-ItemProperty -Path $productIdPath -Name "ActiveConfiguration" -ErrorAction SilentlyContinue

                    if ($activeConfig) {
                        $configName = $activeConfig.ActiveConfiguration
                        $productPath = Join-Path $productIdPath $configName

                        if (Test-Path $productPath) {
                            # Get all subkeys under the active configuration
                            $allSubKeys = Get-ChildItem -Path $productPath

                            $installedEditions = @()
                            foreach ($subKey in $allSubKeys) {
                                $subKeyName = $subKey.PSChildName
                                # Filter for Office product IDs that end with .16 (indicating Office 2016+)
                                if ($subKeyName -match '\.16$' -and
                                    ($subKeyName -match 'Retail|Volume|Promotional|Subscription')) {
                                    $productName = $subKeyName.TrimEnd(".16")
                                    $installedEditions += $productName
                                }
                            }

                            if ($installedEditions.Count -gt 0) {
                                $result = $installedEditions -join ' '
                                return $result
                            }
                        }
                    }
                }
            }
            catch {
                # Continue to next registry path if there's an error
                continue
            }
        }
    }

    # If no Office C2R is found, check traditional Office installations
    $traditionalPaths = @(
        "HKLM:\SOFTWARE\Microsoft\Office\16.0\Common\InstallRoot",
        "HKLM:\SOFTWARE\WOW6432Node\Microsoft\Office\16.0\Common\InstallRoot"
    )

    foreach ($path in $traditionalPaths) {
        if (Test-Path $path) {
            $installPath = Get-ItemProperty -Path $path -ErrorAction SilentlyContinue
            if ($installPath.Path) {
                return "Traditional Office Installation"
            }
        }
    }

    return "No Office installation found"
}

<#
.SYNOPSIS
    Processes Office activation keys from a CSV file in batch mode.

.DESCRIPTION
    This function reads a CSV file containing Office product keys and processes them sequentially
    to validate and activate Office installations. It looks for the first row with an empty 'condition'
    field and processes keys starting from that position.

    For each key, it:
    - Validates the key format (XXXXX-XXXXX-XXXXX-XXXXX-XXXXX)
    - Attempts to install and activate the key using OSPP.vbs
    - Checks the license status to determine if activation was successful
    - Updates the CSV file with appropriate condition values ('BROKEN', item number, or 'UNKNOWN_*')

    The CSV file must contain three required columns: 'key', 'barcode', and 'condition'.
    The function uses a Windows Forms dialog to select the CSV file.

.PARAMETER OSPPPath
    Specifies the full path to the OSPP.vbs script used for Office activation.
    Typically located at "%ProgramFiles%\Microsoft Office\Office16\OSPP.VBS" or similar.

.EXAMPLE
    Invoke-ActivationKeysFromCSV -OSPPPath "$env:ProgramFiles\Microsoft Office\Office16\OSPP.VBS"
    Launches the CSV selection dialog and processes activation keys.

.NOTES
    - The function handles various error conditions including invalid CSV format, missing files,
      activation failures, and license status checking errors
    - Keys are processed sequentially until a valid LICENSED status is found or all rows are processed
    - The CSV file is updated in-place with the new condition values
    - User interruption handling is basic and can be improved in future versions
#>
function Invoke-ActivationKeysFromCSV {
    param (
        [Parameter(Mandatory=$true)]
        [string]$OSPPPath
    )
    # No return value, directly process and modify the CSV file
    # Note: Perfect Ctrl+C handling in PowerShell is complex, this implementation focuses on core functionality
    # User interruption handling can be improved in future versions with more sophisticated mechanisms

    Write-Host "Process Activation Keys from CSV in batch" -ForegroundColor Cyan
    Write-Host "==============================" -ForegroundColor Cyan

    # Get CSV file path
    # Load assembly and create dialog
    Add-Type -AssemblyName System.Windows.Forms
    $dialog = New-Object System.Windows.Forms.OpenFileDialog
    $dialog.Title = "Select a csv file"
    $dialog.Filter = "CSV Files (*.csv)|*.csv"
    $dialog.ShowDialog()

    if ([string]::IsNullOrEmpty($dialog.FileName)) {
        Write-Host "No file selected. Operation cancelled." -ForegroundColor Yellow
        return
    }

    if (-not (Test-Path $dialog.FileName)) {
        Write-Host "Selected file does not exist." -ForegroundColor Red
        return
    }

    try {
        $csvData = Import-Csv -Path $dialog.FileName -ErrorAction Stop
    } catch {
        Write-Host "Unable to read CSV file: $_" -ForegroundColor Red
        return
    }

    if ($csvData.Count -eq 0) {
        Write-Host "CSV file is empty, no data to process" -ForegroundColor Yellow
        return
    }

    $requiredColumns = @('key', 'condition')
    $missingColumns = $requiredColumns | Where-Object { $_ -notin $csvData[0].PSObject.Properties.Name }

    if ($missingColumns.Count -gt 0) {
        Write-Host "CSV file format error, must contain key and condition columns. Missing columns: $($missingColumns -join ', ')" -ForegroundColor Red
        return
    }

    $firstEmptyConditionIndex = -1
    for ($i = 0; $i -lt $csvData.Count; $i++) {
        $conditionValue = $csvData[$i].condition
        if ([string]::IsNullOrWhiteSpace($conditionValue)) {
            $firstEmptyConditionIndex = $i
            break
        }
    }

    # If all condition fields are not empty
    if ($firstEmptyConditionIndex -eq -1) {
        Write-Host "Keys exhausted, no keys available" -ForegroundColor Yellow
        return
    }

    # Start processing from the first row with empty condition
    $processedCount = 0
    $licenseFound = $false

    for ($i = $firstEmptyConditionIndex; $i -lt $csvData.Count; $i++) {
        $row = $csvData[$i]
        $key = $row.key

        # Validate key is not empty
        if ([string]::IsNullOrEmpty($key)) {
            Write-Host "Skipping row $($i+1): key is empty" -ForegroundColor Yellow
            continue
        }

        # Validate key format (Office product key format: XXXXX-XXXXX-XXXXX-XXXXX-XXXXX)
        $key = $key.Trim()
        if ($key -notmatch '^([A-Za-z0-9]{5}-){4}[A-Za-z0-9]{5}$') {
            Write-Host "Skipping row $($i+1): key format invalid" -ForegroundColor Yellow
            continue
        }

        Write-Host "Processing row $($i+1) key: $key" -ForegroundColor Green

        # Temporarily activate Office using this key
        try {
            $activationSuccess = $false
            try {
                & cscript $OSPPPath /inpkey:$key 2>&1 | Out-Null
                & cscript $OSPPPath /act 2>&1 | Out-Null
                $activationSuccess = $true
            } catch {
                $activationSuccess = $false
            }

            if (-not $activationSuccess) {
                Write-Host "Activation failed, marking as BROKEN" -ForegroundColor Red
                $csvData[$i].condition = 'BROKEN'
                # $csvData | Export-Csv -Path $dialog.FileName -NoTypeInformation -Encoding UTF8
                $processedCount++
                continue
            }

        } catch {
            Write-Host "Exception occurred during activation, marking as BROKEN" -ForegroundColor Red
            $csvData[$i].condition = 'BROKEN'
            # $csvData | Export-Csv -Path $dialog.FileName -NoTypeInformation -Encoding UTF8
            $processedCount++
            continue
        }

        # Check license status
        try {
            $statusOutput = & cscript $osppPath /dstatus
            $licenseStatus = $statusOutput | Select-String "LICENSE STATUS:"

            if ($licenseStatus -match 'LICENSED') {
                Write-Host "Found valid activation code! Please enter item number from order:" -ForegroundColor Green
                do {
                    $itemNumber = Read-Host "Item Number"
                    if ([string]::IsNullOrEmpty($itemNumber)) {
                        Write-Host "Item number cannot be empty. Please enter a valid item number." -ForegroundColor Red
                    }
                } while ([string]::IsNullOrEmpty($itemNumber))
                $csvData[$i].condition = $itemNumber

                # Write updated data back to original CSV file
                try {
                    $csvData | Export-Csv -Path $dialog.FileName -NoTypeInformation -Encoding UTF8
                    Write-Host "Successfully wrote results with item number back to CSV file" -ForegroundColor Green
                } catch {
                    Write-Host "Failed to write back to CSV file: $_" -ForegroundColor Red
                }

                $licenseFound = $true
                break
            } elseif ($licenseStatus -match 'OOB_GRACE' -or $licenseStatus -match 'NOTIFICATIONS') {
                Write-Host "Activation code invalid (OOB_GRACE or NOTIFICATIONS), marking as BROKEN" -ForegroundColor Red
                $csvData[$i].condition = 'BROKEN'
                # $csvData | Export-Csv -Path $dialog.FileName -NoTypeInformation -Encoding UTF8
                $processedCount++
            } else {
                Write-Host "Unknown license status, marking as UNKNOWN" -ForegroundColor Yellow
                $csvData[$i].condition = "UNKNOWN_$($licenseStatus.Trim())"
                # $csvData | Export-Csv -Path $dialog.FileName -NoTypeInformation -Encoding UTF8
                $processedCount++
            }

        } catch {
            Write-Host "Exception occurred while checking license status, marking as BROKEN" -ForegroundColor Red
            $csvData[$i].condition = 'BROKEN'
            # $csvData | Export-Csv -Path $dialog.FileName -NoTypeInformation -Encoding UTF8
            $processedCount++
        }
    }

    # If no LICENSED status was encountered during processing, write back to file
    if (-not $licenseFound) {
        try {
            $csvData | Export-Csv -Path $dialog.FileName -NoTypeInformation -Encoding UTF8
            Write-Host "Processing completed, results written back to CSV file" -ForegroundColor Green
            Write-Host "Processed $processedCount rows of data" -ForegroundColor Green
        } catch {
            Write-Host "Failed to write back to CSV file: $_" -ForegroundColor Red
        }
    }
}

if (!(Test-Administrator)) {
    Write-Host "Run this script in Administrator mode!"
    return
}

# Display menu options
Write-Host "Microsoft Office Management" -ForegroundColor Cyan
Write-Host "=============================" -ForegroundColor Cyan
Write-Host "1. Display License Status"
Write-Host "2. Enter Key to activate Office"
Write-Host "3. Remove a single key"
Write-Host "4. Remove All License Keys and reset status"
Write-Host "5. Change Office Edition"
Write-Host "6. Remove All Office Products"
Write-Host "7. Process Activation Keys from CSV in batch"
Write-Host ""

# Get user choice
$userOption = Read-Host "Enter option"

# Find OSPP.VBS file
$osppPath = Find-OSPPFile

if (-not $osppPath) {
    Write-Error "Unable to find OSPP requirement. Reinstall Office may fix issue"
    return
}

# Process user choice
switch ($userOption) {
    "1" {
        $officeInfo = Get-InstalledOfficeEditions
        Write-Host "Installed Office Edition: $officeInfo"
        Write-Host "Retrieving Office license status..."
        try {
            & cscript $osppPath /dstatus
        }
        catch {
            Write-Error "Failed to retrieve license status: $_"
        }
    }

    "2" {
        # Get key from user
        $keyString = Read-Host "Enter Key to activate Office"

        if ([string]::IsNullOrEmpty($keyString)) {
            Write-Error "No key provided. Operation cancelled."
            break
        }

        # Extract valid key using regex
        $keyPattern = "([A-Za-z0-9]{5}-){4}[A-Za-z0-9]{5}"
        if ($keyString -match $keyPattern) {
            $extractedKey = $matches[0]
            Write-Host "Extracted valid key: $extractedKey" -ForegroundColor Green
            $keyString = $extractedKey
        } else {
            Write-Error "No valid Office key format found in input. Operation cancelled."
            break
        }

        Write-Host "Activating Office with key: $keyString" -ForegroundColor Yellow

        try {
            # Activate Office with the provided key
            & cscript $osppPath /inpkey:$keyString 2>&1 | Out-Null
            & cscript $osppPath /act 2>&1 | Out-Null
            Write-Host "Office Activation Successful." -ForegroundColor Green
        }
        catch {
            Write-Error "Failed to activate Office: $_"
        }
    }

    "3" {
        # Get key from user
        $keyString = Read-Host "Enter Key to remove"

        if ([string]::IsNullOrEmpty($keyString)) {
            Write-Warning "No key provided. Operation cancelled."
            break
        }

        Write-Host "Removing key: $keyString" -ForegroundColor Yellow

        try {
            # Get the list of all current product keys before removal
            $currentKeys = Get-OfficeProductKeys -OSPPPath $osppPath
            if ($currentKeys.Count -eq 1 -and $currentKeys[0] -eq $keyString) {
                # If is the last key, remove and rearm
                & cscript $osppPath /unpkey:$keyString 2>&1 | Out-Null
                & cscript $osppPath /rearm 2>&1 | Out-Null
            } else {
                # This is not the last key, just remove it
                & cscript $osppPath /unpkey:$keyString 2>&1 | Out-Null
            }
            Write-Host "Key removed successfully." -ForegroundColor Green
        }
        catch {
            Write-Error "Failed to remove key: $_"
        }
    }

    "4" {
        Write-Host "Removing all License keys..." -ForegroundColor Yellow

        try {
            Write-Host "Getting current license information..."
            $keysToRemove = Get-OfficeProductKeys -OSPPPath $osppPath
            
            if ($keysToRemove.Count -eq 0) {
                Write-Host "No product keys found to remove." -ForegroundColor Yellow
                break
            }
            
            Write-Host "Found $($keysToRemove.Count) product key(s) to remove." -ForegroundColor Yellow
            
            # Remove each key
            $removedCount = 0
            foreach ($key in $keysToRemove) {
                Write-Host "Removing key ending in: $key" -ForegroundColor Yellow
                & cscript $osppPath /unpkey:$key 2>&1 | Out-Null
                $removedCount++
            }
            
            # Rearm Office after removing all keys
            Write-Host "Rearming Office..." -ForegroundColor Yellow
            & cscript $osppPath /rearm 2>&1 | Out-Null
            
            Write-Host "Removed $removedCount of $($keysToRemove.Count) product key(s)." -ForegroundColor Green
            Write-Host "Office has been rearmed. You will need to install a new product key to use Office." -ForegroundColor Green
        }
        catch {
            Write-Error "Failed to remove all product keys: $_"
        }
    }

    "5" {
        Write-Host "1. Office 2019 ProPlus"
        Write-Host "2. Office 2021 ProPlus"
        Write-Host "3. Office 2024 ProPlus"
        Write-Host "4. Office O365 ProPlus"
        $officeEdition = Read-Host "Enter Option"
        Set-OfficeEdition -officeEdition $officeEdition
        $keysToRemove = Get-OfficeProductKeys -OSPPPath $osppPath
        if ($keysToRemove.Count -eq 0) {
            break
        }
        foreach ($key in $keysToRemove) {
            & cscript $osppPath /unpkey:$key 2>&1 | Out-Null
        }
        & cscript $osppPath /rearm 2>&1 | Out-Null
    }

    "6" {
        Write-Host "Removing all Microsoft Office Products."
        Write-Host "Please wait..."
        Start-Process -FilePath "C:\Program Files\Common Files\Microsoft Shared\ClickToRun\OfficeClickToRun.exe" -ArgumentList "platform=x64", "productstoremove=AllProducts" -Wait
    }

    "7" {
        Invoke-ActivationKeysFromCSV -OSPPPath $osppPath
    }

    default {
        Write-Warning "Unknown option selected."
    }
}