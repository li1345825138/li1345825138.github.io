#!/usr/bin/env pwsh
#get ios download url

# Function to validate Apple device identifier format
function Validate-DeviceIdentifier {
    param([string]$Identifier)
    
    # Apple device identifiers typically follow the format: iPhone1,1 or iPad1,1
    $pattern = '^[a-zA-Z]+\d+,\d+$'
   return ($Identifier -match $pattern)
}

# Function to get all availablefirmwares for a device using v4 API
function Get-FirmwareUrl {
    param(
        [string]$DeviceIdentifier
    )
    
    # Validate the device identifier format
    if (-not (Validate-DeviceIdentifier -Identifier $DeviceIdentifier)) {
        Write-Host "Error: Invalid device identifierformat. Expected format: iPhone1,1, iPad1,1, etc." -ForegroundColor Red
        return $null
    }
    
    # Construct the API URL to get allfirmwares
    $apiUrl = "https://api.ipsw.me/v4/device/$DeviceIdentifier"
    
    try {
        Write-Host "Querying firmwares for device: $DeviceIdentifier ..." -ForegroundColor Yellow
        
        # Call the API to get device info with allfirmwares
        $response = Invoke-RestMethod -Uri $apiUrl -Method Get -TimeoutSec 30
        
        if ($response -and $response.firmwares) {
            return $response.firmwares[0].url
        } else {
            Write-Host "No firmwares found for device: $DeviceIdentifier" -ForegroundColor Red
            return $null
        }
    }
    catch {
        Write-Host "Error: $($_.Exception.Message)" -ForegroundColor Red
        return $null
    }
}

# Main script execution
Write-Host "iOS Firmware Download URL Finder" -ForegroundColor Green
Write-Host "=============================================" -ForegroundColor Green

$deviceIdentifier = Read-Host "Enter Apple device identifier (e.g., iPhone1,1, iPad1,1, etc.)"

Write-Host "Using device identifier: $deviceIdentifier" -ForegroundColor Cyan
$firmwareUrl = Get-FirmwareUrl -DeviceIdentifier $deviceIdentifier

if ($firmwareUrl) {
    Write-Host ""
    Write-Host "Latest firmware download URL for ${deviceIdentifier}:" -ForegroundColor Green
    Write-Host $firmwareUrl -ForegroundColor Cyan
} else {
    Write-Host "Could not retrieve firmwareURL for device: $deviceIdentifier" -ForegroundColor Red
    Write-Host "Please verify that the device identifier is correct." -ForegroundColor Yellow
}