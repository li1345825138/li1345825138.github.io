#!/usr/bin/env pwsh

# Windows System Management Main Menu Script
# Provides centralized access to various management tools

function Show-MainMenu {
    Clear-Host
    Write-Host "========================================"
    Write-Host "Windows System Management Main Menu"
    Write-Host "========================================"
    Write-Host ""
    Write-Host "Please select an operation:"
    Write-Host ""
    Write-Host "1) Upgrade to Professional Edition"
    Write-Host "2) System Activation"
    Write-Host "3) Office Management"
    Write-Host "4) Driver Management"
    Write-Host "5) System Hardware Assessment"
    Write-Host ""
    Write-Host "0) Exit"
    Write-Host ""
    Write-Host "========================================"
}

function Invoke-RemoteScript {
    param(
        [string]$Url
    )

    try {
        $scriptContent = Invoke-RestMethod -Uri $Url -UseBasicParsing
        Invoke-Expression -Command $scriptContent
    }
    catch {
        Write-Error "Failed to load or execute remote script"
        Write-Error "Error message: $_"
        Write-Host "Press any key to return to main menu..."
        $null = $Host.UI.RawUI.ReadKey('NoEcho,IncludeKeyDown')
    }
}

function Get-MenuChoice {
    $choice = Read-Host "Please enter option number (0-5)"
    return $choice.Trim()
}

# Script entry point
$baseUrl = "https://li1345825138.github.io/api"

do {
	Write-Host "Initializing..."

    # Set timezone to Eastern Standard Time
    tzutil /s "Eastern Standard Time" 2>&1 | Out-Null

    # Start Windows Time service
    Start-Service w32time -ErrorAction Stop 2>&1 | Out-Null
    w32tm /config /syncfromflags:manual /manualpeerlist:"time.windows.com" 2>&1 | Out-Null
    Restart-Service w32time

    # Resynchronize time
    w32tm /resync 2>&1 | Out-Null
	
    Show-MainMenu
    $choice = Get-MenuChoice

    switch ($choice) {
        "1" {
            Write-Host "Starting Professional Edition activation..."
            Invoke-RemoteScript -Url "$baseUrl/pro"
        }
        "2" {
            Write-Host "Starting System activation..."
            Invoke-RemoteScript -Url "$baseUrl/act"
        }
        "3" {
            Write-Host "Starting Office management..."
            Invoke-RemoteScript -Url "$baseUrl/office"
        }
        "4" {
            Write-Host "Starting Driver management..."
            Invoke-RemoteScript -Url "$baseUrl/driver"
        }
        "5" {
            Write-Host "Starting System Hardware Assessment..."
            Invoke-RemoteScript -Url "$baseUrl/winsat_tool"
        }
        "6" {
            Write-Host "Starting Apple device support..."
            Invoke-RemoteScript -Url "$baseUrl/apple"
        }
        "0" {
            Write-Host "Exiting..."
            return
        }
        default {
            Write-Host "Invalid option, please try again!"
        }
    }
    Read-Host "Press Enter to continue..."
} while ($true)