###
# Pro version 2, for debug use
# Checks for admin rights, and elevates if needed
# Upgrades Windows edition to Professional with built-in key

function Test-Admin {
    $currentUser = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
    return $currentUser.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

function Start-Elevated {
    $arguments = "-ExecutionPolicy Bypass -File `"$($MyInvocation.MyCommand.Path)`""
    Start-Process powershell.exe -Verb RunAs -ArgumentList $arguments
    exit
}

# Check if running as administrator
if (-not (Test-Admin)) {
    Write-Host "Requesting administrative privileges..."
    Start-Elevated
}

Write-Host "Checking Windows version..."

# Get Windows build number
$winbuild = (Get-ItemProperty "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion").CurrentBuild

# Check Windows version
if ($winbuild -lt 22000) {
    Write-Host "Windows 10 detected"
} elseif ($winbuild -ge 22000) {
    Write-Host "Windows 11 detected"
} else {
    Write-Error "Unknown Windows version"
    exit 1
}

Write-Host "Upgrading Windows to Professional edition..."

try {
    # Execute DISM command to upgrade Windows edition
    dism /online /set-edition:Professional /productkey:VK7JG-NPHTM-C97JM-9MPGT-3V66T /accepteula /Quiet
    PAUSE
    shutdown /r /t 0
} catch {
    Write-Error "An error occurred during the upgrade process: $_"
    exit 1
}
